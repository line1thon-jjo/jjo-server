DATABASE_URL=postgresql+psycopg://jjo:jjo@localhost:5432/jjo

# Gemini. 키는 .env에만 넣고 커밋하지 말 것
GEMINI_API_KEY=
# 연습 제목 생성
GEMINI_MODEL=gemini-3.5-flash-lite
# 분석 리포트 AI 피드백 (서버 혼잡이면 예비 모델로 한 번 재시도)
GEMINI_FEEDBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FEEDBACK_FALLBACK_MODEL=gemini-3.5-flash-lite

GOOGLE_CLIENT_IDS=[]
AUTH_ISSUER=jjo
SIGNUP_TOKEN_SECRET=
ACCESS_TOKEN_SECRET=
SIGNUP_TOKEN_TTL_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=3600
